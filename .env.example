# Anthropic — get yours at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Lemon Squeezy — get yours at app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1Q...
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
# Find Store ID at app.lemonsqueezy.com/settings/general (copy the number from the URL)
LEMONSQUEEZY_STORE_ID=12345
# Find Variant ID by opening your product → click the variant → copy ID from URL
LEMONSQUEEZY_VARIANT_ID=67890

# Resend — get yours at resend.com (free tier works)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Career Launch Pack <you@yourdomain.com>

# Your deployed URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
