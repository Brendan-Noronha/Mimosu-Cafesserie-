# Resend — admin notification email on new onboarding submissions
# get yours at resend.com (free tier works)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Mimosu Onboarding <onboarding@yourdomain.com>
ADMIN_NOTIFICATION_EMAIL=you@yourdomain.com

# Vercel Blob — durable storage for onboarding files & records.
# Attach a Blob store to the Vercel project and this is injected automatically.
# Without it, uploads/records fall back to local disk for `npm run dev` only.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Your deployed URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
