# Resend — admin notification email + lead follow-up automation
# get yours at resend.com (free tier works)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Mimosu Onboarding <onboarding@yourdomain.com>
ADMIN_NOTIFICATION_EMAIL=you@yourdomain.com

# Vercel Blob — durable storage for onboarding files & records.
# Attach a Blob store to the Vercel project and this is injected automatically.
# Without it, uploads/records fall back to local disk for `npm run dev` only.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Anthropic — AI lead qualification (scores leads hot/warm/cold/spam).
# Without this, leads default to "warm" for manual review.
ANTHROPIC_API_KEY=sk-ant-...

# Meta Lead Ads — receives leads automatically from connected clients' Page forms.
# Create a Meta App with the Webhooks + Leads Retrieval products, subscribe your
# Page(s) to the "leadgen" field, and set the webhook URL to
# https://your-app.vercel.app/api/webhooks/meta-leads
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=choose-any-string-and-reuse-it-in-the-meta-dashboard
# A System User access token (from your own Business Manager) with
# leads_retrieval + pages_read_engagement permissions on your clients' Pages.
META_ACCESS_TOKEN=your-long-lived-system-user-token

# Razorpay — invoicing and payment collection.
# get yours at dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard > Settings > Webhooks — subscribe to "payment.captured" and point it
# at https://your-app.vercel.app/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Follow-up automation cron — Vercel sends this as a Bearer token automatically
# when set; on the Hobby plan Vercel Cron only runs once/day, so for tighter
# intervals point an external scheduler (e.g. cron-job.org) at
# /api/cron/follow-ups with the same bearer secret.
CRON_SECRET=choose-a-random-secret

# Your deployed URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
